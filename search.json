---
layout: none
---
{% assign all = "" | split: "" %}
{% for post in site.posts %}
  {% assign all = all | push: post %}
{% endfor %}
{% for page in site.pages %}
  {% if page.title %}
    {% assign all = all | push: page %}
  {% endif %}
{% endfor %}
[
  {% for item in all %}
    {
      "title"   : {{ item.title | jsonify }},
      "url"     : {{ item.url | prepend: site.baseurl | jsonify }},
      "date"    : {{ item.date | date: "%B %d, %Y" | jsonify }},
      "content" : {{ item.content | strip_html | strip_newlines | truncate: 500 | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
