---
layout: none
---
[
  {% for post in site.posts %}
    {
      "title"   : {{ post.title | jsonify }},
      "url"     : {{ post.url | prepend: site.baseurl | jsonify }},
      "date"    : {{ post.date | date: "%B %-d, %Y" | jsonify }},
      "category": {{ post.categories | first | default: "Post" | jsonify }},
      "content" : {{ post.content | strip_html | strip_newlines | truncate: 300 | jsonify }}
    }
    {% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.posts.size > 0 and site.pages.size > 0 %},{% endif %}
  {% assign searchable_pages = site.pages | where_exp: "p", "p.title != nil and p.url != '/search/'" %}
  {% for page in searchable_pages %}
    {
      "title"   : {{ page.title | jsonify }},
      "url"     : {{ page.url | prepend: site.baseurl | jsonify }},
      "date"    : "",
      "category": {{ page.layout | default: "Page" | capitalize | jsonify }},
      "content" : {{ page.content | strip_html | strip_newlines | truncate: 300 | jsonify }}
    }
    {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
